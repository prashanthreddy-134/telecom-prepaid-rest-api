POSTGRES_DB=telecom
POSTGRES_USER=telecom
POSTGRES_PASSWORD=replace-with-a-strong-random-password

DATABASE_URL=postgresql+psycopg://telecom:replace-with-a-strong-random-password@db:5432/telecom

SECRET_KEY=replace-with-long-random-secret
RATE_LIMIT=120/minute
PLANS_RATE_LIMIT=200/minute
REDIS_URL=redis://redis:6379/0
PLAN_CACHE_TTL_SECONDS=60